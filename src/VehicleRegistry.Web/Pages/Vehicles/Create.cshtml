@page
@model VehicleRegistry.Web.Pages.Vehicles.CreateModel
@{
    ViewData["Title"] = "Add vehicle";
}
<h1>Add vehicle</h1>
<p class="lede">The weight category is worked out automatically from the weight.</p>

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>

    <div class="field">
        <label asp-for="Input.OwnerName">Owner's name</label>
        <input asp-for="Input.OwnerName" required maxlength="@VehicleRules.MaxOwnerNameLength" autocomplete="name" />
        <span asp-validation-for="Input.OwnerName" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.ManufacturerId">Manufacturer</label>
        <select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, nameof(ManufacturerOption.Id), nameof(ManufacturerOption.Name)))" required>
            <option value="">Choose a manufacturer</option>
        </select>
        <span asp-validation-for="Input.ManufacturerId" class="field-error"></span>
    </div>

    <div class="field field--short">
        <label asp-for="Input.YearOfManufacture">Year of manufacture</label>
        <input asp-for="Input.YearOfManufacture" type="number" inputmode="numeric" min="@VehicleRules.EarliestYear" required />
        <span asp-validation-for="Input.YearOfManufacture" class="field-error"></span>
    </div>

    <div class="field field--short">
        <label asp-for="Input.WeightKg">Weight (kg)</label>
        <input asp-for="Input.WeightKg" type="number" inputmode="decimal" step="0.01" min="0.01" required aria-describedby="weight-hint" />
        <span id="weight-hint" class="hint">Up to two decimal places, for example 1850.75</span>
        <span asp-validation-for="Input.WeightKg" class="field-error"></span>
         <p id="category-preview" class="category-preview" aria-live="polite"></p>
    </div>

    <div class="form-actions">
        <button type="submit" class="button">Add vehicle</button>
        <a asp-page="/Index">Cancel</a>
    </div>
</form>
<script>
    // Live preview only. The server applies the same rule when saving and is the source of truth.
    (() => {
        const categories = @Json.Serialize(Model.Categories.Select(c => new { c.Name, c.IconKey, Min = c.MinWeightKg }));
        const input = document.getElementById("Input_WeightKg");
        const preview = document.getElementById("category-preview");
        const ordered = [...categories].sort((a, b) => a.min - b.min);

        function update() {
            const weight = parseFloat(input.value);
            preview.replaceChildren();
            if (!(weight > 0)) return;

            // Same rule as CategoryRules.Resolve: greatest start <= weight.
            const match = ordered.filter(c => c.min <= weight).pop();
            if (!match) return;

            const icon = document.createElement("img");
            icon.src = `/icons/${match.iconKey}.svg`;
            icon.alt = "";
            icon.width = 24;
            icon.height = 24;

            const text = document.createElement("span");
            text.textContent = `This vehicle will be categorised as ${match.name}.`;

            preview.append(icon, text);
        }

        input.addEventListener("input", update);
        update();
    })();
</script>