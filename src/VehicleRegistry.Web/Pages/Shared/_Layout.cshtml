<!DOCTYPE html>
<html lang="en-NZ">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Vehicle Registry</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-page="/Index">Vehicle Registry</a>
            <nav aria-label="Main">
                <a asp-page="/Index">Vehicles</a>
                <a asp-page="/Vehicles/Create">Add vehicle</a>
                <a asp-page="/Categories/Index">Weight categories</a>
            </nav>
        </div>
    </header>
    <main class="page">
        @if (TempData["StatusMessage"] is string message)
        {
            <p class="notice" role="status">@message</p>
        }
        @RenderBody()
    </main>
</body>
</html>