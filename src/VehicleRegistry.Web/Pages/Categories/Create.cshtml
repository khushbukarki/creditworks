@page
@model VehicleRegistry.Web.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "Add category";
}
<h1>Add category</h1>
<p class="lede">The new category takes over part of the range of the category it starts inside.</p>

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
    <partial name="_CategoryFields" for="Input" />
    <div class="form-actions">
        <button type="submit" class="button">Add category</button>
        <a asp-page="Index">Cancel</a>
    </div>
</form>